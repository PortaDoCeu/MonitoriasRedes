# Copie este arquivo para config.env e preencha (ADR-025).
# O config.env tem senhas e NÃO vai para o git.

# real: CLP da bancada | simulado: o iniciar.ps1 sobe o clp_simulado.py
MODO=real

# Identificação da bancada (prefixo dos tópicos MQTT). O monitor informa o número.
BANCADA=bancada1

# CLP da bancada. No modo simulado use MODBUS_HOST=127.0.0.1 e MODBUS_PORT=5020
MODBUS_HOST=192.168.0.11
MODBUS_PORT=502

# Broker MQTT (ADR-031). sim: o broker do próprio grupo, neste notebook (etapa 2).
# Plano B, broker do monitor: BROKER_LOCAL=nao, MQTT_HOST=<ip do monitor> e as
# credenciais gateway_bancadaN / middleware_bancadaN que o monitor entregar.
BROKER_LOCAL=sim
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORTA=9001
MQTT_USUARIO_GATEWAY=gateway
MQTT_SENHA_GATEWAY=troque_aqui
MQTT_USUARIO_MIDDLEWARE=middleware
MQTT_SENHA_MIDDLEWARE=troque_aqui
APP_LEITURA_SENHA=leitura

# Planta (ADR-003): VEL_MAX vem da placa do motor
VEL_MAX=1700
PERIODO_LEITURA_S=1

# Middleware: o app abre em http://<ip-deste-notebook>:HTTP_PORTA
HTTP_PORTA=8000
